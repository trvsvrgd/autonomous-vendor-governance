# PostgreSQL 16+ Database Connection
DATABASE_URL=postgresql+psycopg://governance_admin:governance_secret_pw@localhost:5432/vendor_governance

# AWS Backing Resources (Use AWS_ENDPOINT_URL=http://localhost:4566 for LocalStack, omit for AWS Production)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
S3_ARCHIVE_BUCKET=enterprise-ai-vendor-governance-archives
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/vendor-governance-ingestion-queue
SQS_EVALUATION_QUEUE_URL=http://localhost:4566/000000000000/vendor-governance-evaluation-queue
SQS_EVALUATION_DLQ_URL=http://localhost:4566/000000000000/vendor-governance-evaluation-dlq
EVENTBRIDGE_BUS_NAME=default

# Gemini Execution Bridge (harness | api | vertex)
GEMINI_EXECUTION_MODE=harness
GEMINI_HARNESS_COMMAND=python -m app.inference.gemini_harness_cli
GEMINI_MODEL_ID=gemini-2.5-pro
AWS_SECRETS_GEMINI_SECRET_ID=prod/vendor-governance/gemini-credentials
AWS_SECRETS_WEBHOOKS_SECRET_ID=prod/vendor-governance/notification-webhooks
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# Corporate Identity (OIDC / AWS Cognito) & Cryptographic Signoff
OIDC_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EnterprisePool
OIDC_AUDIENCE=enterprise-ai-governance-client
OIDC_JWKS_URL=
OIDC_VERIFY_SIGNATURE=false
SIGNOFF_HMAC_KEY=enterprise-cryptographic-signoff-integrity-key

# Notification Channels & Reporting
SES_SENDER_EMAIL=governance-alerts@enterprise.internal
GOVERNANCE_REPORT_EMAIL=travisvreugdenhil@gmail.com
MAX_WORKER_STEPS=50
